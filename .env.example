# Copy this file to .env or set these variables manually in your shell.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback LLM. If the primary Groq model fails, the agent retries here.
# Recommended: a smaller/faster Groq model for resilience under load.
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional path overrides
SUPPLY_CHAIN_MODELS_DIR=supply_chain_agent_training_outputs/models
SUPPLY_CHAIN_KB_DIR=supply_chain_agent_training_outputs/knowledge_base
SUPPLY_CHAIN_DATA_PATH=data/global_supply_chain_disruption_v1.csv

# Use only for historical CSV replay/demo rows. Do NOT enable for real-time inference.
SUPPLY_CHAIN_REPLAY_MODE=0

# Optional demo mode only. Keep disabled in real operations.
# When disabled, observed delay/status signals trigger resolution and the classifier
# is exposed only as an early-warning risk prior.
SUPPLY_CHAIN_CLASSIFIER_CAN_TRIGGER_RESOLUTION=0
